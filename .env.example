# Copy to .env.local (gitignored) and fill in what you use. Never commit real values.

# AI catch-up summary and the AI friend Ari (Claude). Without it both use fallbacks.
# ANTHROPIC_API_KEY=

# Friends' and Ari's spoken lines (OpenAI text-to-speech). Without it they show as bubbles.
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voice cloning (your own voice): set one provider, or leave unset to use text bubbles.
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# VOICE_PROVIDER=sovits
# SOVITS_URL=
# SOVITS_KEY=
